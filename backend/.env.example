# Copy this file to .env and fill in the values. Never commit .env.

DATABASE_URL=postgresql+psycopg://localhost/command_center

ANTHROPIC_API_KEY=sk-ant-...
EXTRACT_MODEL=claude-haiku-4-5-20251001
AGENT_MODEL=claude-haiku-4-5-20251001

# Filled in during the Google OAuth step
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Generate later with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=

TIMEZONE=Europe/Istanbul

# Where Google login sends you back to (the frontend dev server)
FRONTEND_URL=http://localhost:5173

# "Sync now" and the background job extract tasks from up to this many new emails per run
EXTRACT_ON_SYNC_LIMIT=50
# Run sync + extraction every 30 minutes inside the API process (true/false)
BACKGROUND_SYNC_ENABLED=true
